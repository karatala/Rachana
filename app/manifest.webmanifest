{
  "id": "./",
  "name": "Rachana",
  "short_name": "Rachana",
  "description": "Music notation and playback editor",
  "start_url": "./",
  "scope": "./",
  "file_handlers": [{
    "action": "./",
    "launch_type": "single-client",
    "accept": {
      "application/x-rachana": [".rcn"],
      "application/octet-stream": [".gp", ".gp3", ".gp4", ".gp5", ".gpx"],
      "audio/midi": [".mid", ".midi"]
    }
  }],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "theme_color": "#000000",
  "background_color": "#000000",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape-primary"
}
